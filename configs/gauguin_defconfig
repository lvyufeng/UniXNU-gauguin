# Kernel configuration of the gauguin image. CONFIG_XNU_<NAME> becomes XNU_<NAME>
# for the kernel build.
#
# Deliberately minimal: the port targets the bring-up stages in
# docs/porting/bring-up.md first (UEFI, menu, payload, DarwinBoot, kernel entry,
# storage, root, userland) and adds display/input/GPU drivers once each stage is
# observed on the device.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y

# NativeAES, and every archive that gates on it (NativeRamBlock, NativeUfs),
# needs the original kernelcache's crypto prelink closure: prng_random keeps the
# stock implementation and comes from the prelinked component instead of the
# source provider.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
